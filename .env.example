RUGLLM_API_KEY="your_rug_llm_key"
WEB_CONCURRENCY=4
WEB_RELOAD=true
UNPAYWALL_EMAIL="your_email_adress"

# Bind the web service to loopback by default. For a reverse proxy on another
# VM, set this to the application VM's private address and restrict access to
# the proxy VM with a network firewall.
DOCKER_WEB_PORT_FORWARD=127.0.0.1:8000

# Set this to an absolute path when production secrets live outside the Git
# checkout. Compose also uses the file for the container environment.
JUST_OS_ENV_FILE=.env
